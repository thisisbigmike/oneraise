# Copy to .env / .env.local and fill in real values. Never commit real secrets.

# --- Database (Supabase / Postgres) ---
# Pooled Supavisor transaction string (port 6543, with ?pgbouncer=true)
DATABASE_URL=
# Direct connection (port 5432) — used by Prisma migrations
DIRECT_URL=

# --- Auth (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Development-only admin login bypass (ignored in production builds)
ADMIN_BYPASS_PASSWORD=

# --- Email ---
# Provider selector: resend | brevo
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
RESEND_TEST_TO=
BREVO_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Payments: Busha (local rails) ---
BUSHA_BASE_URL=
BUSHA_API_KEY=
BUSHA_API_VERSION=
BUSHA_SECRET_TOKEN=
BUSHA_WEBHOOK_SECRET=

# --- Payments: MoonPay (card) ---
MOONPAY_PUBLIC_KEY=
MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=
MOONPAY_WEBHOOK_SECRET=
MOONPAY_WIDGET_BASE_URL=
NEXT_PUBLIC_CARD_LIVE=false

# --- Payments: Paystack ---
PAYSTACK_SECRET_KEY=

# --- Solana / Jupiter ---
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_TREASURY_WALLET=
NEXT_PUBLIC_SOLANA_TREASURY_WALLET=
# Treasury signer for automated on-chain refunds (F5). Server-only — NEVER expose.
# JSON byte array (solana-keygen output) or base64-encoded 64-byte secret key.
# Must control the wallet that received Jupiter donations. Leave blank to keep
# refunds manual (intent is still recorded + donors notified).
SOLANA_TREASURY_SECRET_KEY=
JUPITER_API_KEY=
DEFAULT_SETTLEMENT_ASSET=USDC
DEFAULT_SETTLEMENT_NETWORK=solana

# --- Notifications: SMS ---
# Provider selector: termii | twilio  (auto-detected from keys if unset)
SMS_PROVIDER=
# Termii (Nigeria-optimized)
TERMII_API_KEY=
TERMII_SENDER_ID=OneRaise
TERMII_CHANNEL=generic
# Twilio (also used for WhatsApp below)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=

# --- Notifications: WhatsApp ---
# Provider selector: meta | twilio  (auto-detected from keys if unset)
WHATSAPP_PROVIDER=
# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
# Twilio WhatsApp (reuses TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN above)
TWILIO_WHATSAPP_FROM=

# --- AI ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Cloudflare Turnstile (CAPTCHA) ---
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
